generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  employeeCode  String   @unique @map("employee_code") @db.VarChar(50)
  fullName      String   @map("full_name") @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  phoneNumber   String?  @map("phone_number") @db.VarChar(20)
  department    String?  @db.VarChar(100)
  position      String?  @db.VarChar(100)
  role          String   @default("user") @db.VarChar(20)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  attendances      Attendance[]
  employeeSalary   EmployeeSalary?
  overtimeRecords  OvertimeRecord[]
  payrolls         Payroll[]
  leaveRequests    LeaveRequest[]
  notifications    Notification[]

  @@index([email])
  @@index([employeeCode])
  @@map("users")
}

model AttendanceConfig {
  id                    Int      @id @default(autoincrement())
  workStartTime         String   @map("work_start_time") @db.VarChar(5)
  workEndTime           String   @map("work_end_time") @db.VarChar(5)
  lateToleranceMinutes  Int      @default(15) @map("late_tolerance_minutes")
  earlyCheckInMaxHours  Decimal  @default(3) @map("early_checkin_max_hours") @db.Decimal(4, 2)
  lateCheckInMaxHours   Decimal  @default(4) @map("late_checkin_max_hours") @db.Decimal(4, 2)
  minWorkDurationHours  Decimal  @default(4) @map("min_work_duration_hours") @db.Decimal(4, 2)
  updatedBy             Int?     @map("updated_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("attendance_config")
}

model LeaveRequest {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  type        String    @db.VarChar(30)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  reason      String    @db.Text
  status      String    @default("pending") @db.VarChar(20)
  reviewedBy  Int?      @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNote  String?   @map("review_note") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String    @db.VarChar(255)
  message   String    @db.Text
  type      String    @default("info") @db.VarChar(30)
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  Int?     @map("entity_id")
  details   String?  @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PayrollConfig {
  id                          Int      @id @default(autoincrement())
  overtimeHourlyRate          Decimal  @default(50000) @map("overtime_hourly_rate") @db.Decimal(15, 2)
  absenceDeductionPerDay      Decimal  @default(50000) @map("absence_deduction_per_day") @db.Decimal(15, 2)
  bpjsKetenagakerjaanPercent  Decimal  @default(2) @map("bpjs_ketenagakerjaan_percent") @db.Decimal(5, 2)
  bpjsKesehatanPercent        Decimal  @default(1) @map("bpjs_kesehatan_percent") @db.Decimal(5, 2)
  incomeTaxPercent            Decimal  @default(21) @map("income_tax_percent") @db.Decimal(5, 2)
  updatedBy                   Int?     @map("updated_by")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("payroll_config")
}

model Attendance {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  checkInTime        DateTime  @map("check_in_time")
  checkOutTime       DateTime? @map("check_out_time")
  checkInLatitude    Decimal   @map("check_in_latitude") @db.Decimal(10, 8)
  checkInLongitude   Decimal   @map("check_in_longitude") @db.Decimal(11, 8)
  checkOutLatitude   Decimal?  @map("check_out_latitude") @db.Decimal(10, 8)
  checkOutLongitude  Decimal?  @map("check_out_longitude") @db.Decimal(11, 8)
  status             String    @default("present") @db.VarChar(20)
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checkInTime])
  @@map("attendances")
}

model SalaryComponent {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(20)
  isTaxable   Boolean  @default(false) @map("is_taxable")
  isActive    Boolean  @default(true) @map("is_active")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollItems             PayrollItem[]

  @@index([type])
  @@map("salary_components")
}

model EmployeeSalary {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  baseSalary   Decimal  @map("base_salary") @db.Decimal(15, 2)
  effectiveDate DateTime @map("effective_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  components EmployeeSalaryComponent[]

  @@map("employee_salaries")
}

model EmployeeSalaryComponent {
  id                Int      @id @default(autoincrement())
  employeeSalaryId  Int      @map("employee_salary_id")
  componentId       Int      @map("component_id")
  amount            Decimal  @db.Decimal(15, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  employeeSalary EmployeeSalary  @relation(fields: [employeeSalaryId], references: [id], onDelete: Cascade)
  component      SalaryComponent @relation(fields: [componentId], references: [id])

  @@unique([employeeSalaryId, componentId])
  @@map("employee_salary_components")
}

model OvertimeRecord {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  date        DateTime  @db.Date
  hours       Decimal   @db.Decimal(5, 2)
  hourlyRate  Decimal   @map("hourly_rate") @db.Decimal(15, 2)
  totalAmount Decimal   @map("total_amount") @db.Decimal(15, 2)
  status      String    @default("pending") @db.VarChar(20)
  notes       String?   @db.Text
  approvedBy  Int?      @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("overtime_records")
}

model PayrollPeriod {
  id        Int      @id @default(autoincrement())
  year      Int
  month     Int
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String   @default("open") @db.VarChar(20)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payrolls Payroll[]

  @@unique([year, month])
  @@map("payroll_periods")
}

model Payroll {
  id                 Int      @id @default(autoincrement())
  periodId           Int      @map("period_id")
  userId             Int      @map("user_id")
  baseSalary         Decimal  @map("base_salary") @db.Decimal(15, 2)
  totalAllowance     Decimal  @default(0) @map("total_allowance") @db.Decimal(15, 2)
  totalDeduction     Decimal  @default(0) @map("total_deduction") @db.Decimal(15, 2)
  overtimeAmount     Decimal  @default(0) @map("overtime_amount") @db.Decimal(15, 2)
  attendanceDeduction Decimal @default(0) @map("attendance_deduction") @db.Decimal(15, 2)
  grossSalary        Decimal  @map("gross_salary") @db.Decimal(15, 2)
  netSalary          Decimal  @map("net_salary") @db.Decimal(15, 2)
  totalWorkDays      Int      @map("total_work_days")
  totalPresent       Int      @map("total_present")
  totalAbsent        Int      @map("total_absent")
  totalLate          Int      @default(0) @map("total_late")
  totalOvertimeHours Decimal  @default(0) @map("total_overtime_hours") @db.Decimal(7, 2)
  status             String   @default("draft") @db.VarChar(20)
  notes              String?  @db.Text
  paidAt             DateTime? @map("paid_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  PayrollItem[]

  @@unique([periodId, userId])
  @@index([userId])
  @@index([status])
  @@map("payrolls")
}

model PayrollItem {
  id          Int      @id @default(autoincrement())
  payrollId   Int      @map("payroll_id")
  componentId Int      @map("component_id")
  type        String   @db.VarChar(20)
  name        String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  payroll   Payroll         @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@index([payrollId])
  @@map("payroll_items")
}

model Schedule {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  shiftName   String   @map("shift_name") @db.VarChar(50)
  startTime   String   @map("start_time") @db.VarChar(5)
  endTime     String   @map("end_time") @db.VarChar(5)
  room        String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  leaderId    Int?     @map("leader_id")
  updatedBy   Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members ScheduleMember[]

  @@unique([date])
  @@map("schedules")
}

model ScheduleMember {
  id         Int      @id @default(autoincrement())
  scheduleId Int      @map("schedule_id")
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, userId])
  @@map("schedule_members")
}
